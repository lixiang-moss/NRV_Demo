<launch>
  <arg name="serial_number" default="" />
  <arg name="device_index" default="0" />
  <arg name="sensor_setting_path" default="/opt/ros/noetic/share/delta_driver/config/sensor/Delta_01_1000FPS.txt" />
  <arg name="decode_events" default="true" />
  <arg name="show_gui" default="true" />
  <arg name="duration" default="0" />
  <arg name="output_dir" default="/output/manual" />
  <arg name="message_threshold_time_ms" default="10" />
  <arg name="image_fps" default="10" />
  <arg name="bridge_host" default="127.0.0.1" />
  <arg name="bridge_port" default="0" />

  <node name="delta_manager" pkg="nodelet" type="nodelet" args="manager" required="true" output="screen" />
  <node name="delta_driver" pkg="nodelet" type="nodelet"
        args="load delta_driver/DriverNodelet /delta_manager" output="screen">
    <rosparam file="$(find delta_driver)/config/delta_driver.yaml" command="load" />
    <param name="serial_number" type="str" value="$(arg serial_number)" />
    <param name="device_index" value="$(arg device_index)" />
    <param name="sensor_setting_path" value="$(arg sensor_setting_path)" />
    <param name="frame_id" value="delta_camera_optical_frame" />
    <param name="message_threshold_time_ms" value="$(arg message_threshold_time_ms)" />
    <param name="message_threshold_size_bytes" value="1048576" />
    <param name="max_queued_messages" value="200" />
  </node>

  <group if="$(arg decode_events)">
    <group ns="dvs">
      <node name="event_adapter" pkg="nodelet" type="nodelet"
            args="load nrv_demo/DvsAdapterNodelet /delta_manager" output="screen">
        <param name="input_topic" value="/delta_driver/events" />
        <param name="output_topic" value="events" />
        <param name="camera_info_topic" value="camera_info" />
      </node>
    </group>
    <node name="delta_renderer" pkg="nodelet" type="nodelet"
          args="load delta_tools/RendererNodelet /delta_manager" output="screen">
      <param name="topic" value="/delta_driver/events" />
      <param name="image_fps" value="$(arg image_fps)" />
      <param name="subscriber_queue_size" value="1" />
    </node>
    <group if="$(arg show_gui)">
      <node name="nrv_input_view" pkg="rqt_image_view" type="rqt_image_view" args="/delta_renderer/image" />
      <node name="nrv_algorithm_view" pkg="rqt_image_view" type="rqt_image_view" args="/nrv_python_demo/image" />
    </group>
  </group>

  <node name="nrv_python_demo" pkg="nrv_demo" type="demo.py" required="true" output="screen">
    <param name="decode_events" value="$(arg decode_events)" />
    <param name="duration" value="$(arg duration)" />
    <param name="image_fps" value="$(arg image_fps)" />
    <param name="output_dir" value="$(arg output_dir)" />
    <param name="bridge_host" value="$(arg bridge_host)" />
    <param name="bridge_port" value="$(arg bridge_port)" />
  </node>
</launch>
