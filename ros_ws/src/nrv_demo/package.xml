<?xml version="1.0"?>
<package format="2">
  <name>nrv_demo</name>
  <version>0.1.0</version>
  <description>NRV camera and E2FAI reconstruction/optical-flow demo.</description>
  <maintainer email="lixiang-moss@users.noreply.github.com">lixiang-moss</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <build_depend>nlohmann-json-dev</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <depend>camera_info_manager</depend>
  <depend>dvs_msgs</depend>
  <depend>event_camera_codecs</depend>
  <depend>event_camera_msgs</depend>
  <depend>nodelet</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>delta_driver</exec_depend>
  <exec_depend>delta_tools</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <export><nodelet plugin="${prefix}/nodelet_plugins.xml" /></export>
</package>
